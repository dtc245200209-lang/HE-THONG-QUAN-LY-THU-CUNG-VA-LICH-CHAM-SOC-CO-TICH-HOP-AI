APP_ENV=development
ENVIRONMENT=development

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=petcare
POSTGRES_PASSWORD=petcare123
POSTGRES_DB=petcare

# Redis Cache & Broker
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
SECRET_KEY=a_very_secret_key_for_jwt_auth
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Primary AI Provider (API Key - Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Local Ollama (Disabled by default)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# MinIO Object Storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=petcare

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8001/api/v1/ws
